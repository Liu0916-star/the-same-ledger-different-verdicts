# Raw data (~240 MB parquet + v1 CSVs): archived on Zenodo, re-extractable with sql/
gnn-decentralization/data/*
!gnn-decentralization/data/.gitkeep

# Results: keep JSON/CSV and the arrays the paper commits to archiving
gnn-decentralization/results*/*
!gnn-decentralization/results*/*.json
!gnn-decentralization/results*/*.csv
!gnn-decentralization/results*/*.md
!gnn-decentralization/results/graph_*_1w.npz
!gnn-decentralization/results/graph_*_5w.npz
!gnn-decentralization/results/emb_*_1w_s*.npy
!gnn-decentralization/results/emb_*_1w_s*.fp
!gnn-decentralization/results/emb_n2v_*_1w_s*.npy
!gnn-decentralization/results/emb_n2v_*_1w_s*.fp
!gnn-decentralization/results/edgeweight_compare_*.npz
gnn-decentralization/results_spec_*/manifest.csv
gnn-decentralization/results/manifest.csv
gnn-decentralization/figures_v1/

# Working copies of figures (paper/figures/ is authoritative)
gnn-decentralization/figures/

# Logs
gnn-decentralization/logs/
gnn-decentralization/logs_*.log

# LaTeX build files
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.synctex.gz
paper/*.fdb_latexmk
paper/*.fls
paper/*.spl
paper/main.pdf
paper/diff_v1_v2.*

# Python, editors, OS
__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/
.DS_Store

# v16 legacy: only the file make_numbers.py reads
gnn-decentralization/results_v16_legacy/*
!gnn-decentralization/results_v16_legacy/c3_typology.json
.Rhistory
# v2_auc_ci.py pairs the main graph with the overwrite-spec graph
!gnn-decentralization/results_spec_overwrite/graph_*_1w.npz
